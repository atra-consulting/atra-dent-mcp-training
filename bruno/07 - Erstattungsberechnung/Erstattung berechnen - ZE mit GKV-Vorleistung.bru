meta {
  name: Erstattung berechnen - ZE mit GKV-Vorleistung
  type: http
  seq: 1
}

post {
  url: {{rechenkernUrl}}/erstattungsberechnung
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tarifId": "ATRA_DENT_B",
    "versicherungsbeginn": "2022-03-01",
    "behandlungsdatum": "2022-05-01",
    "positionen": [
      {"goz": "2210", "leistungsbereich": "ZE", "betrag": "1000.00",
       "beschreibung": "Krone Regio 36"}
    ],
    "gkvLeistung": "300.00"
  }
}

assert {
  res.status: eq 200
  res.body.erstattungsbetrag: isDefined
  res.body.versicherungsjahr: eq 1
}

tests {
  // Geldbeträge als Dezimalstring geprüft, nicht per assert: ein assert-Block
  // parste den Erwartungswert zur Zahl und vergliche damit am Drahtformat
  // vorbei (siehe "Beitrag berechnen" in Ordner 02).
  test("450.00 EUR Erstattung, 250.00 EUR Eigenanteil", function() {
    const antwort = res.getBody();
    expect(antwort.erstattungsbetrag).to.equal("450.00");
    expect(antwort.rechnungsbetrag).to.equal("1000.00");
    expect(antwort.eigenanteil).to.equal("250.00");
  });

  test("sechs Rechenschritte in verbindlicher Reihenfolge", function() {
    const schritte = res.getBody().schritte.map((s) => s.schritt);
    expect(schritte).to.eql([
      "ERSTATTUNGSFAEHIG", "QUOTE", "SUBLIMIT", "GKV", "SELBSTBEHALT", "STAFFEL"
    ]);
  });
}

docs {
  Eine ZE-Position (Zahnersatz) bei atra.dent.balance im ersten
  Versicherungsjahr, ohne Vorverbrauch (kein `verbrauch`-Feld — der erste
  Schadensfall des Vertrags). Die Zahlen stammen aus
  `ErstattungsrechnungTest.fall_1` und `ErstattungsberechnungControllerTest`
  im Rechenkern:

  - Rechnungsbetrag 1000.00 EUR
  - Quote ZE bei balance: 85 % einschließlich GKV-Vorleistung → 850.00 EUR
  - GKV-Vorleistung 300.00 EUR abgezogen → 550.00 EUR
  - Selbstbehalt balance: 100.00 EUR/Jahr, noch unverbraucht → 450.00 EUR
  - Zahnstaffel Jahr 1 greift nicht (450.00 EUR liegen darunter)

  Ergebnis: **450.00 EUR** Erstattung, 250.00 EUR Eigenanteil.
}
