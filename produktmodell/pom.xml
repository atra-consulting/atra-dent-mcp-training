<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>consulting.atra</groupId>
  <artifactId>produktmodell</artifactId>
  <version>1.0.0</version>
  <name>atra.dent Produktmodell</name>
  <description>
    Liest wissen/daten/tarife.yaml in Java-Typen: Tarife, Leistungen,
    Staffeln, Ausschluesse. Die eine Stelle, an der das Produktmodell
    ausgelegt wird - Wissensdienst und Rechenkern haengen beide daran.

    Die Datei selbst bleibt unter wissen/daten/, weil Typst aus ihr die
    Bedingungswerke setzt. Genau daraus folgt, dass die gerechnete Quote und
    der zitierfaehige Satz im Bedingungswerk nicht auseinanderlaufen koennen.
  </description>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>

    <dependency>
      <groupId>tools.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

</project>
