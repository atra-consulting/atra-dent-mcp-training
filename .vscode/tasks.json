{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "setup.sh",
      "detail": "Werkzeuge pruefen, Abhaengigkeiten aller Bausteine installieren",
      "type": "shell",
      "command": "./setup.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "start.sh",
      "detail": "Das Lab starten -- alle acht Bausteine",
