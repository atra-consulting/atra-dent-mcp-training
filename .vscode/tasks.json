        "panel": "dedicated",
        "group": "lab"
      }
    },
    {
      "label": "start.sh --debug",
      "detail": "Das Lab starten und die Debug-Ports oeffnen -- danach 'Debug: Alle'",
      "type": "shell",
      "command": "./start.sh --debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "lab"
      }
    },
    {
      "label": "stop.sh",
      "detail": "Das Lab beenden, wenn Strg+C nicht gereicht hat",
      "type": "shell",
      "command": "./stop.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
